#!/usr/bin/env bash
set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Strip comments and blank lines for length check
MSG_CLEAN=$(echo "$COMMIT_MSG" | grep -v '^#' | sed '/^$/d' | head -1)

if [ ${#MSG_CLEAN} -lt 10 ]; then
    echo "ERROR: Commit message must be at least 10 characters."
    echo "Got: \"$MSG_CLEAN\" (${#MSG_CLEAN} chars)"
    exit 1
fi

echo "Commit message OK."
