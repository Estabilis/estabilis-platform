#!/usr/bin/env bash
set -euo pipefail

echo "Running pre-commit checks..."

# Check terraform formatting
if command -v terraform &> /dev/null; then
    CHANGED_TF=$(git diff --cached --name-only --diff-filter=ACM | grep '\.tf$' || true)
    if [ -n "$CHANGED_TF" ]; then
        echo "Checking Terraform formatting..."
        for dir in providers/*/; do
            if [ -d "$dir" ]; then
                if ! terraform fmt -check -recursive "$dir" > /dev/null 2>&1; then
                    echo "ERROR: Terraform files not formatted in $dir"
                    echo "Run: terraform fmt -recursive $dir"
                    exit 1
                fi
            fi
        done
        echo "Terraform formatting OK."

        # Validate Terraform configuration (only if providers are fully initialized)
        for dir in providers/*/; do
            if [ -d "$dir/.terraform/providers" ]; then
                echo "Validating Terraform: $dir"
                if ! terraform -chdir="$dir" validate > /dev/null 2>&1; then
                    echo "ERROR: Terraform validation failed in $dir"
                    terraform -chdir="$dir" validate
                    exit 1
                fi
                echo "Terraform validation OK: $dir"
            fi
        done
    fi
else
    echo "WARNING: terraform not found, skipping format check."
fi

# Prevent committing secrets
SECRETS_PATTERN='secrets\.env$|\.pem$|\.key$|\.env$'
STAGED_SECRETS=$(git diff --cached --name-only | grep -E "$SECRETS_PATTERN" || true)
if [ -n "$STAGED_SECRETS" ]; then
    echo "ERROR: Potentially sensitive files staged for commit:"
    echo "$STAGED_SECRETS"
    echo "Remove them with: git reset HEAD <file>"
    exit 1
fi

echo "Pre-commit checks passed."
