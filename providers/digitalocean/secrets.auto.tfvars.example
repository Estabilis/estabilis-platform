# ============================================================================
# Estabilis Platform — DigitalOcean provider secrets
# ============================================================================
# Copy to secrets.auto.tfvars (gitignored, auto-loaded by Terraform).
#
# PREFER NOT TO USE THIS FILE. The DigitalOcean provider reads its token from
# DIGITALOCEAN_ACCESS_TOKEN, and a token supplied that way never reaches a
# file on disk. A token passed as var.do_token is recorded in the state.
#
#   export DIGITALOCEAN_ACCESS_TOKEN="dop_v1_..."
#
# The token needs write access to Kubernetes, VPC and (from phase 2) Spaces.
# ============================================================================

# do_token = "dop_v1_CHANGE_ME"
