# ============================================================================
# Estabilis Platform — AWS sensitive inputs
# ============================================================================
# Copy to secrets.auto.tfvars (git-ignored, auto-loaded by Terraform).
#
#   cp secrets.auto.tfvars.example secrets.auto.tfvars
#
# Preferred alternative: export these as TF_VAR_<name> environment variables
# from a .env file that stays out of the working directory entirely, so the
# secrets never live next to the Terraform config on disk.
# ============================================================================

# --- Private Git repos (only when the repo URL is private) ---
config_repo_token        = ""
client_gitops_repo_token = ""

# --- DNS (only when dns_provider = "cloudflare") ---
cloudflare_api_token = ""

# --- Grafana LLM plugin (optional) ---
openai_api_key = ""

# --- ECR pull-through cache for Docker Hub (only when the docker-hub upstream
# is declared in ecr_pull_through_cache_upstreams) ---
# A Secrets Manager secret ARN holding { username, accessToken }.
# Create the secret manually in Secrets Manager (outside this Terraform config)
# and paste its ARN here.
ecr_dockerhub_credentials_secret_arn = ""
